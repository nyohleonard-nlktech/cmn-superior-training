{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/registrations/:id/paid",
      "destination": "/api/registrations/[id]/paid"
    },
    {
      "source": "/api/registrations/:id/completed",
      "destination": "/api/registrations/[id]/completed"
    },
    {
      "source": "/api/registrations/:id",
      "destination": "/api/registrations/[id]"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products/[id]"
    },
    {
      "source": "/((?!api/|images/|assets/|public/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

